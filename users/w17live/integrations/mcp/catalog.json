    {
      "name": "mcp.weather.get_weather_forecast",
      "description": "Return upcoming forecast values at coordinates. Every value includes its unit and exact UTC valid time.",
      "input_schema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "start": {
            "type": "string",
            "description": "Optional ISO 8601 time with Z or UTC offset."
          },
          "hours": {
            "type": "integer",
            "default": 24,
            "minimum": 1,
            "maximum": 168
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional metadata parameter codes."
          },
          "interpolation": {
            "type": "string",
            "enum": [
              "nearest",
              "linear"
            ],
            "default": "nearest"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "additionalProperties": false
