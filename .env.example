API_KEY=вставьте_сюда_ваш_ключ

# RAG: локальный сервис эмбеддингов (Ollama). Секретов нет — только localhost.
OLLAMA_EMBED_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3

# Локальная генерация (LM Studio). Секретов нет — только loopback.
LMSTUDIO_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=mradermacher/Qwen2.5-Coder-3B-Instruct-Distill-Qwen3-Coder-Next-abliterated-GGUF:Qwen2.5-Coder-3B-Instruct-Distill-Qwen3-Coder-Next-abliterated.Q6_K.gguf

# Ollama-чат (альтернативный локальный провайдер; не обязателен).
OLLAMA_CHAT_URL=http://127.0.0.1:11434

# Дефолтная модель агента: cloud | lmstudio:<id> | ollama:<id> | mock
AI9_MODEL=cloud

# Шлюз на VPS (этап 10). Секрет подписи сессии.
# Если НЕ задан — шлюз сгенерирует автосекрет в gateway/.secret (решение №27).
# Значение — длинная случайная строка; в git НЕ коммитится (только имя здесь).
GATEWAY_SECRET=вставьте_длинную_случайную_строку
# Порт и адрес шлюза (по умолчанию 0.0.0.0:8080 — единственный публичный порт).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080